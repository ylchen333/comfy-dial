{
  "name": "@comfy-dial/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run --passWithNoTests",
    "loop": "node --experimental-strip-types --no-warnings src/cli.ts",
    "preflight": "node --experimental-strip-types --no-warnings src/preflight-cli.ts",
    "replay": "node --experimental-strip-types --no-warnings src/replay-cli.ts",
    "repair": "node --experimental-strip-types --no-warnings src/repair-cli.ts",
    "serve": "node --experimental-strip-types --no-warnings src/serve.ts"
  },
  "dependencies": {
    "@comfy-dial/contracts": "workspace:*",
    "@comfy-dial/rig-core": "workspace:*"
  }
}
