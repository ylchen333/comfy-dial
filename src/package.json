{
  "name": "comfy-dial",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test && uv run pytest verifier",
    "typecheck": "pnpm -r typecheck",
    "loop": "pnpm --filter @comfy-dial/server loop",
    "preflight": "pnpm --filter @comfy-dial/server preflight",
    "replay": "pnpm --filter @comfy-dial/server replay",
    "repair": "pnpm --filter @comfy-dial/server repair",
    "serve": "pnpm --filter @comfy-dial/server serve"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
